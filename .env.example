# Copie para .env e ajuste. O .env nao vai para o repositorio.

# Porta publicada no host. O container sempre escuta em 3000.
APP_PORT=3000

# O servico `db` do docker-compose sobe com usuario, banco e senha padrao
# (zine / geracao_zine / zine). Defina as variaveis POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DB e DB_PORT no seu .env para trocar, e mantenha
# a DATABASE_URL coerente com elas.

# Login com Google (Google Identity Services, fluxo Authorization Code).
# Crie as credenciais em https://console.cloud.google.com/apis/credentials com
# o tipo "Aplicativo da Web". A origem autorizada precisa incluir a URL em que
# o app roda (http://localhost:3000 no desenvolvimento).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Segredo do JWT da sessao. Gere com: openssl rand -base64 48
# Minimo de 32 caracteres; o app recusa subir com menos.
JWT_SECRET=

# Usada pelo Prisma. O host e `localhost` porque as migrations rodam do host;
# dentro do compose o app recebe a mesma URL com o host trocado para `db`.
# Em producao use uma URL com sslmode=require.
DATABASE_URL="postgresql://zine:zine@localhost:5432/geracao_zine?schema=public"
