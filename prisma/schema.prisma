// Schema Code-First. A fonte da verdade e este arquivo: as migrations sao
// geradas a partir dele e nunca editadas a mao.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Conta criada pelo fluxo "Entrar com Google".
///
/// O `googleId` guarda o `sub` do ID token, que e estavel e nunca muda. O email
/// pode mudar de dono na Google, entao ele identifica a conta apenas na primeira
/// entrada, quando ainda nao existe `googleId` vinculado.
model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  name          String?
  avatarUrl     String?
  googleId      String?  @unique
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  zines     Zine[]
  favorites Favorite[]

  @@map("users")
}

/// Quem pode ver um zine.
///
/// O padrao e `private`: publicar e acao explicita, com confirmacao, porque
/// divulgar sem pedir nao tem desfazer. A escolha e reversivel pelo seletor
/// no editor e na lista.
enum ZineVisibility {
  private
  public
}

/// Zine guardado na conta.
///
/// `content` recebe o mesmo JSON do rascunho de `localStorage`, entao o
/// editor nao precisa de duas representacoes. `contentVersion` acompanha
/// `DRAFT_VERSION`: sem ele, um JSON antigo so pode ser interpretado
/// adivinhando a forma, e migrar depois exige inspecionar cada linha.
model Zine {
  id             String         @id @default(uuid()) @db.Uuid
  ownerId        String         @db.Uuid
  title          String
  visibility     ZineVisibility @default(private)
  content        Json
  contentVersion Int            @default(1)
  /// Identificador curto da URL publica. Nulo enquanto o zine e privado.
  slug           String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@index([ownerId])
  @@index([visibility, updatedAt])
  @@map("zines")
}

/// Zine que alguem marcou para achar depois.
///
/// Nao e uma copia nem um reaproveitamento: guarda so a referencia, entao
/// desfavoritar nao toca no zine. A chave e o par (`userId`, `zineId`), porque
/// favoritar duas vezes nao pode criar duas linhas.
model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  zineId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  zine Zine @relation(fields: [zineId], references: [id], onDelete: Cascade)

  @@unique([userId, zineId])
  @@index([zineId])
  @@map("favorites")
}
